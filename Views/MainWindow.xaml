<Window x:Class="FuzzyGameEngine.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FuzzyGameEngine.Views"
        mc:Ignorable="d"
        Title="Fuzzy AI Game Engine"
        Height="600" Width="1000"
        Background="#0F0F1A">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <StackPanel>

            <TextBlock Text="🎮 AI Difficulty Controller"
                       Foreground="White"
                       FontSize="22"
                       Margin="0,0,0,20"/>

            <!-- TIME -->
            <TextBlock Text="Time (seconds)" Foreground="Gray"/>
            <Slider Minimum="0" Maximum="200"
                    Value="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding Time, StringFormat=Value: {0:F0} sec}" Foreground="White"/>

            <!-- ENEMIES -->
            <TextBlock Text="Enemies (count)" Foreground="Gray"/>
            <Slider Minimum="0" Maximum="20"
                    Value="{Binding Enemies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding Enemies, StringFormat=Value: {0:F0}}" Foreground="White"/>

            <!-- HEALTH -->
            <TextBlock Text="Health (%)" Foreground="Gray"/>
            <Slider Minimum="0" Maximum="100"
                    Value="{Binding Health, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding Health, StringFormat=Value: {0:F0}%}" Foreground="White"/>

            <!-- ACCURACY -->
            <TextBlock Text="Accuracy (%)" Foreground="Gray"/>
            <Slider Minimum="0" Maximum="100"
                    Value="{Binding Accuracy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding Accuracy, StringFormat=Value: {0:F0}%}" Foreground="White"/>

            <!-- DAMAGE -->
            <TextBlock Text="Damage Taken (%)" Foreground="Gray"/>
            <Slider Minimum="0" Maximum="100"
                    Value="{Binding Damage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding Damage, StringFormat=Value: {0:F0}%}" Foreground="White"/>

            <Button Content="🚀 Calculate"
                    Command="{Binding CalculateCommand}"
                    Height="45"
                    Margin="0,20,0,0"
                    Background="#6C63FF"
                    Foreground="White"
                    FontWeight="Bold"/>

        </StackPanel>

        <!-- RIGHT PANEL -->
        <StackPanel Grid.Column="1">

            <TextBlock Text="AI Result"
                       Foreground="White"
                       FontSize="20"/>

            <!-- RESULT -->
            <TextBlock Text="{Binding Result}"
                       Foreground="#6C63FF"
                       FontSize="28"
                       Margin="0,10"/>

            <!-- PROGRESS BAR -->
            <ProgressBar Minimum="0" Maximum="100"
                         Value="{Binding DifficultyValue}"
                         Height="25"
                         Margin="0,10"/>

            <TextBlock Text="{Binding DifficultyLevel}"
                       Foreground="White"
                       FontSize="18"/>

            <!-- EXPLANATION -->
            <Border Background="#1E1E2E" Padding="10" CornerRadius="10" Margin="0,10">
                <ScrollViewer Height="200">
                    <TextBlock Text="{Binding Explanation}"
                               Foreground="White"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- HISTORY -->
            <TextBlock Text="History"
                       Foreground="White"
                       FontSize="16"/>

            <ListBox ItemsSource="{Binding History}" Height="120"/>

        </StackPanel>
    </Grid>
</Window>